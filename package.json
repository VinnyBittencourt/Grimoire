    "better-sqlite3": "^12.9.0",
    "dompurify": "^3.4.17",
    "express": "^5.2.1",
    "grimoire-design-system": "github:VinnyBittencourt/grimoire-design-system",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
